<?xml version="1.0" encoding="utf-8"?>
<!-- Vault keys live in the Keystore and never leave the device, so a cloud/device-transfer copy of the
     encrypted files would be unreadable. Users back up with the app's own passphrase-encrypted .aivault file. -->
<data-extraction-rules>
    <cloud-backup><exclude domain="root" /><exclude domain="file" /><exclude domain="sharedpref" /><exclude domain="database" /></cloud-backup>
    <device-transfer><exclude domain="root" /><exclude domain="file" /><exclude domain="sharedpref" /><exclude domain="database" /></device-transfer>
</data-extraction-rules>
